# Copy to .env.flow4.local (ignored) or inject through an approved secret store.
# Never commit populated credentials or raw access tokens.
FLOW4_VALIDATION_MODE=local
FLOW4_E2E_ENABLED=true
FLOW4_BASE_URL=http://127.0.0.1:4200
FLOW4_API_URL=http://127.0.0.1:5150/api/v1
FLOW4_ARTIFACT_DIR=test-results/flow4

# Secrets / controlled identities
FLOW4_POSTGRES_PASSWORD=
FLOW4_ADMIN_EMAIL=
FLOW4_ADMIN_PASSWORD=
FLOW4_SECOND_ADMIN_EMAIL=
FLOW4_SECOND_ADMIN_PASSWORD=
FLOW4_VIEW_EMAIL=
FLOW4_VIEW_PASSWORD=
FLOW4_NO_BILLING_EMAIL=
FLOW4_NO_BILLING_PASSWORD=

# Deterministic fixture manifest values. Tokens are secrets.
FLOW4_OPERATION_ID=
FLOW4_AWAITING_TOKEN=
FLOW4_PROOF_FILE=.flow4/fixtures/valid-proof.pdf
FLOW4_SUBMITTED_TOKEN=
FLOW4_SUBMITTED_PAYMENT_ID=
FLOW4_DUPLICATE_ASSERTION_URL=
FLOW4_QUEUE_SEARCH=FLOW4
FLOW4_APPROVABLE_PAYMENT_ID=
FLOW4_PAID_PAYMENT_ID=
FLOW4_REJECTABLE_PAYMENT_ID=
FLOW4_REJECTED_TOKEN=
FLOW4_INFO_PAYMENT_ID=
FLOW4_ACTION_REQUIRED_TOKEN=
FLOW4_CONFLICT_PAYMENT_ID=
FLOW4_EXPIRED_TOKEN=
FLOW4_REVOKED_TOKEN=
FLOW4_INVALID_EVIDENCE_TOKEN=
FLOW4_UNCLEAN_PAYMENT_ID=
FLOW4_NOTIFICATION_FAILED_PAYMENT_ID=
FLOW4_CROSS_TENANT_PROOF_URL=
FLOW4_RETRY_OPERATION_ID=
FLOW4_ACTIVE_PAYMENT_ID=
FLOW4_HAPPY_OPERATION_ID=
FLOW4_HAPPY_PAYMENT_ID=
FLOW4_HAPPY_TOKEN=

# Backend environment names (double underscore is .NET configuration nesting).
ConnectionStrings__DefaultConnection=
ManualPaymentEvidenceScanner__Host=127.0.0.1
ManualPaymentEvidenceScanner__Port=53310
AzureBlobStorage__ConnectionString=
AzureBlobStorage__ContainerName=flow4-private-payment-evidence
AzureBlobStorage__CreateContainerIfNotExists=true
AzureBlobStorage__PublicBaseUrl=
TenantOnboardingOutbox__Enabled=true
TenantOnboardingOutbox__PaymentAccessBaseUrl=http://127.0.0.1:4200/payment
TenantOnboardingOutbox__TenantAdminAppBaseUrl=http://127.0.0.1:4200
TenantOnboardingOutbox__ManualPaymentInstructions=FLOW 4 TEST ONLY - use the synthetic bank reference shown on the invoice.
TenantOnboardingOutbox__PaymentSupportDetails=FLOW 4 TEST ONLY - flow4-support@example.invalid / +1-555-0100
AzureCommunicationEmail__ConnectionString=
AzureCommunicationEmail__Endpoint=
AzureCommunicationEmail__SenderAddress=
AzureCommunicationEmail__SenderDisplayName=OneVerz Flow 4 Test
DevelopmentSeed__PlatformAdmin__BillingViewer__Email=
DevelopmentSeed__PlatformAdmin__BillingViewer__Password=
DevelopmentSeed__PlatformAdmin__NoBilling__Email=
DevelopmentSeed__PlatformAdmin__NoBilling__Password=

# Secure fixture CLI bootstrap (inject through a secret store; never commit a value).
FLOW4_FIXTURE_BOOTSTRAP_CREDENTIAL=
Flow4TestHost__Enabled=true
Flow4TestHost__MarkerNonce=
Flow4TestHost__EmailMode=SUPPRESSED
Flow4TestHost__RequiredDatabaseRole=flow4_runner
Flow4TestHost__TokenTtlMinutes=30
